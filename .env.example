NODE_ENV=development

# --- Supabase project (API keys from Project Settings → API) ---
# These are the values the Supabase dashboard shows first.
# The publishable/anon key is public by design (safe in the browser).
# NEVER put the service_role key in NEXT_PUBLIC_* variables.
#
# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://bamhpwjygxoitwwymreu.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_PASSWORD=

# Region for the Supabase pooler (Project Settings → Database → Connection string).
# Required on networks that only resolve db.*.supabase.co over IPv6 (common on Windows).
SUPABASE_REGION=ap-northeast-2

# --- Or paste full Postgres URIs yourself (any provider / self-host) ---
# If both are set, they win over SUPABASE_DB_PASSWORD derivation.
#
# DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
#
# Local self-host example:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/alivecheck"
# DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/alivecheck"

DATABASE_URL=
DIRECT_URL=

API_PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=

CHECKER_USER_AGENT=AliveCheck/1.0
